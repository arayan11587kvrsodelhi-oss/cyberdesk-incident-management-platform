# CYBERDESK environment variables
# Copy this file to `.env` and adjust the values for your environment.
# Never commit `.env` — it is git-ignored by convention.

# PostgreSQL connection string (required).
# Server-only. Must NEVER be prefixed with NEXT_PUBLIC_, which would inline it
# into the client bundle.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Secret used to sign/derive session material. Generate with:
#   openssl rand -hex 32
# Server-only. Must NEVER be prefixed with NEXT_PUBLIC_.
# Required in production and must be >= 32 characters; the application throws
# on startup/first use if it is missing or too short in production, so it cannot
# silently fall back to a default in production.
AUTH_SECRET=replace-with-a-long-random-string

# Optional. Absolute URL the app is served from (used for absolute URLs in
# metadata). No trailing slash required.
# APP_URL=https://your-deployment.vercel.app

# Required to run the destructive fictional demo-data seed script. Keep false/unset in production unless you intentionally want the demo reset.
# NOTE: the seed provisions users with a fixed, publicly documented demo
# password. Never run it against a production database.
DEMO_SEED=false

# --- Notes for production ------------------------------------------------
# * `next start` / Vercel set NODE_ENV=production automatically.
# * There are deliberately NO NEXT_PUBLIC_* variables in this project. Anything
#   added under that prefix is shipped to the browser and must never be secret.
# * No analytics, third-party scripts, or external API keys are configured.
